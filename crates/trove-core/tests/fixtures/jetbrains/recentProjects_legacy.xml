<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic fixture: PyCharm 2019.1 and earlier recentProjects.xml
     Represents the legacy format with only recentPaths (no additionalInfo).
     Paths have no timestamps; activationTimestamp defaults to 0 (epoch). -->
<application>
  <component name="RecentProjectsManager">
    <option name="recentPaths">
      <list>
        <option value="$USER_HOME$/OldProject" />
        <option value="/absolute/path/project" />
      </list>
    </option>
  </component>
</application>
